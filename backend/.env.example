# FastCloud injects PORT automatically; do not set it manually.
TRACEIT_CLIP_ENABLED=1
TRACEIT_DINO_ENABLED=1
TRACEIT_CLIP_MODEL=openai/clip-vit-base-patch32
TRACEIT_DINO_MODEL=facebook/dinov2-small
TRACEIT_CORS_ORIGINS=https://YOUR-FRONTEND-DOMAIN
# Use persistent storage in production.
TRACEIT_DB=/data/traceit.db
TRACEIT_UPLOADS=/data/uploads
